# OpenAI ChatKit Configuration
NEXT_PUBLIC_OPENAI_DOMAIN_KEY=your-openai-chatkit-domain-key
NEXT_PUBLIC_CHATKIT_API_ENDPOINT=http://localhost:8000/api/chat # Your backend chat endpoint

# Better Auth Integration (if applicable)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000 # Your backend URL for general API calls
NEXT_PUBLIC_JWT_SECRET=your-jwt-secret # For client-side token generation/validation if needed
