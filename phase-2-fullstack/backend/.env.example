# Database Configuration
# Replace with your actual Neon PostgreSQL connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Configuration
# For development, use a random secret key (generate with: openssl rand -hex 32)
# For production, use a secure secret key and keep it private
JWT_SECRET_KEY=your-secret-key-here-replace-with-random-hex-32
JWT_ALGORITHM=HS256

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
# For development: http://localhost:3000
# For production: https://your-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Better Auth Configuration (Optional - for production)
# URL to fetch Better Auth public key for JWT signature validation
# BETTER_AUTH_PUBLIC_KEY_URL=https://auth.hackathon-todo.com/.well-known/jwks.json

# Gemini API Configuration (Phase III - AI Chatbot)
# Get your API key from: https://makersuite.google.com/app/apikey
# Free tier: 1500 requests/day, 15 requests/minute
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Chatbot Context Configuration
# Sliding window size (number of recent messages to include)
CHAT_CONTEXT_WINDOW_SIZE=15
# Summary regeneration interval (number of messages)
CHAT_SUMMARY_INTERVAL=20
# Maximum summary token count
CHAT_SUMMARY_MAX_TOKENS=500

# Retry and Circuit Breaker Configuration
# Exponential backoff retry attempts
CHAT_RETRY_MAX_ATTEMPTS=3
# Circuit breaker failure threshold
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Circuit breaker open duration (seconds)
CIRCUIT_BREAKER_OPEN_DURATION=60

# Rate Limiting Configuration (Phase III)
# Maximum requests per window (matches Gemini free tier limit)
RATE_LIMIT_REQUESTS=15
# Window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# Deployment Configuration (Vercel)
# ============================================================================
# For deployment to Vercel, ensure these environment variables are set
# in the Vercel dashboard under Project Settings > Environment Variables
#
# Required for Production:
# - DATABASE_URL (Neon PostgreSQL connection string)
# - JWT_SECRET_KEY (must match frontend)
# - GEMINI_API_KEY (from makersuite.google.com)
# - CORS_ORIGINS (your frontend Vercel domain)
#
# Optional:
# - GEMINI_MODEL (default: gemini-2.5-flash)
# - CHAT_CONTEXT_WINDOW_SIZE (default: 15)
# - CHAT_SUMMARY_INTERVAL (default: 20)
# - RATE_LIMIT_REQUESTS (default: 15)
# ============================================================================
